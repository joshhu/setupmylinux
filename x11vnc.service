[Unit]
Description=Start x11vnc at startup.
After=network-online.target multi-user.target display-manager.service

[Service]

User=root
ExecStart=/usr/bin/x11vnc -rfbport 5900 -display :0 -auth guess -forever -rfbauth /home/joshhu/.vnc/passwd
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
